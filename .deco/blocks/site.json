{
  "seo": {
    "type": "website",
    "image": "/image/hero.jpg",
    "title": "Sillage",
    "jsonLDs": [],
    "noIndexing": false,
    "description": "Niche eau de parfum, composed in Grasse and aged six months before it leaves us.",
